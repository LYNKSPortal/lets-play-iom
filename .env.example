# Let's Play — environment variable reference
# Copy this file to .env.local for local development and fill in real values.
# Never commit .env.local or real secrets to version control.

# --- Email delivery (Resend) -------------------------------------------------
# All form submissions (contact, camp booking, programme registration) are
# delivered as a notification email via Resend. Get an API key from
# https://resend.com. Never expose this to the browser.
RESEND_API_KEY=
# Sender address. Must be on a domain verified in your Resend account, or use
# the shared sandbox sender below for testing (works without verifying a
# domain, but may land in spam and should not be used long-term).
RESEND_FROM_EMAIL=Let's Play <onboarding@resend.dev>
# Inbox that receives all form submissions.
RESEND_TO_EMAIL=info@letsplay.co.im
# Public flag mirrored to the client to control demo-mode messaging. Set to
# "true" once RESEND_API_KEY is configured so forms show real (not demo)
# confirmation messaging.
NEXT_PUBLIC_EMAIL_NOTIFICATIONS_ENABLED=

# --- AWS (future backend services, secure file storage, real bookings DB) --
# Not required for the email-based flow above. Reserved for a future
# capacity-checked booking/registration backend (API Gateway + Lambda +
# DynamoDB/PostgreSQL) and/or secure file storage.
AWS_REGION=
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
