# Let's Play — environment variable reference
# Copy this file to .env.local for local development and fill in real values.
# Never commit .env.local or real secrets to version control.

# --- Booking backend (AWS) --------------------------------------------------
# URL of the secure AWS-hosted booking API (API Gateway + Lambda, or similar).
# When unset, the booking flow runs in a clearly labelled demo mode and does
# not persist or confirm real bookings.
BOOKING_API_URL=
# Bearer token / API key used to authenticate server-to-server calls to the
# booking API above. Never expose this to the browser.
BOOKING_API_KEY=
# Public flag mirrored to the client to control demo-mode messaging.
# Set to the same value as BOOKING_API_URL being configured (any non-empty
# string) once the backend is live.
NEXT_PUBLIC_BOOKING_API_URL=

# --- Contact form email delivery -------------------------------------------
# Name of the configured email provider (e.g. "ses", "resend", "postmark").
# When unset, the contact form clearly tells users submission is unavailable
# and shows direct email/phone alternatives instead of a false success state.
CONTACT_FORM_PROVIDER=
# Provider-specific credentials (examples — adjust to the provider chosen).
CONTACT_FORM_API_KEY=
CONTACT_FORM_FROM_EMAIL=
CONTACT_FORM_TO_EMAIL=info@letsplay.co.im

# --- AWS (future backend services, secure file storage) --------------------
AWS_REGION=
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
